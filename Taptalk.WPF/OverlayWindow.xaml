<Window x:Class="Taptalk.WPF.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taptalk"
        Width="72" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="20" Top="20">

    <Grid>
        <Ellipse x:Name="PulseRing" Width="56" Height="56"
                 Stroke="#007AFF" StrokeThickness="2" Opacity="0"
                 IsHitTestVisible="False"/>

        <Ellipse x:Name="MicButton" Width="56" Height="56"
                 Fill="#F2F2F7" Stroke="#E5E5EA" StrokeThickness="1"
                 Cursor="Hand" MouseLeftButtonDown="MicButton_OnMouseDown"
                 MouseLeftButtonUp="MicButton_OnMouseUp"
                 MouseMove="MicButton_OnMouseMove">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="Black"/>
            </Ellipse.Effect>
        </Ellipse>

        <TextBlock x:Name="MicIcon" Text="🎙️" FontSize="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
